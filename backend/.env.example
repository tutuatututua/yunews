# Backend-only environment (safe to commit)
# Get these from Supabase Dashboard → Project Settings → API

SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co

# Service role bypasses RLS. Keep it server-side only.
SUPABASE_SERVICE_ROLE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY

# Chatbot (RAG)
# Required for `/chat`.
OPENAI_API_KEY=YOUR_OPENAI_API_KEY

OPENAI_CHAT_MODEL=gpt-4.1-mini

# Retrieval embeddings (used for Supabase vector search)
# Default: OpenAI embeddings (recommended for serverless like Vercel)
EMBEDDING_PROVIDER=openai
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Optional: sentence-transformers embeddings (large deps; not recommended on Vercel)
# To use this mode you must install extra packages (torch/transformers/sentence-transformers)
# and set:
#   EMBEDDING_PROVIDER=hf
#   HF_EMBEDDING_MODEL=Qwen/Qwen3-Embedding-0.6B
# Optional token; public models work without it, but a token can help with rate limits.
HF_TOKEN=YOUR_HF_TOKEN
HF_EMBEDDING_MODEL=Qwen/Qwen3-Embedding-0.6B
EMBEDDING_DEVICE=auto

# Runtime environment
LOG_LEVEL=INFO

# CORS
# In production, set an explicit allowlist (comma-separated) matching your frontend origin(s).
# Example: CORS_ALLOW_ORIGINS=https://yunews.example.com
CORS_ALLOW_ORIGINS=http://localhost:5173
# Optional hardening: lock Host header to known values.
# Example: TRUSTED_HOSTS=yunews.example.com,api.yunews.example.com
TRUSTED_HOSTS=
