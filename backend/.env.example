# Backend API environment (example)
# Copy to backend/.env for local dev, or set these in Vercel project env vars.

# Required
SUPABASE_URL="https://<your-project-ref>.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="<your-supabase-service-role-key>"

# CORS (set for local dev or if calling API directly from browser)
CORS_ALLOW_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

# Chat (required for /chat)
OPENAI_API_KEY="<your-openai-api-key>"
OPENAI_CHAT_MODEL="gpt-4.1-mini"

# Embeddings (RAG)
# Vercel-safe option: call a hosted Hugging Face embeddings endpoint (no torch).
EMBEDDINGS_BACKEND="hf_hosted"  # one of: hf_hosted | openai | sentence_transformers

# Hugging Face hosted embeddings endpoint URL.
# If you use a TEI/OpenAI-compatible endpoint, set it to .../v1/embeddings
HF_EMBEDDINGS_ENDPOINT_URL="https://<your-endpoint-host>/v1/embeddings"

# Optional: token for private endpoints / HF Inference Endpoints
HF_TOKEN="<your-hf-token>"

# Model name (used when calling OpenAI-compatible endpoints and for logging/metadata)
HF_EMBEDDING_MODEL="Qwen/Qwen3-Embedding-0.6B"

# Optional
BACKEND_PORT=8080
