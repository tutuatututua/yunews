# Required
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Optional: API key to protect backend routes (leave empty to disable auth)
API_KEY=

# OpenAI (required for chat/embeddings)
OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-4.1-mini
OPENAI_QUERY_PLANNER_MODEL=gpt-4.1-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Server
PORT=8080
LOG_LEVEL=INFO

# CORS (comma-separated origins, or * for all)
CORS_ALLOW_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Token quota per IP (0 = disabled)
CHAT_TOKENS_PER_IP_PER_WINDOW=0
CHAT_TOKEN_WINDOW_SECONDS=86400

# Logging
LOG_VISIT_IPS=true
LOG_CHAT_HISTORY=true
