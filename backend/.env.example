# Backend API environment (example)

# CORS
# If your frontend is on a different origin (e.g. Vercel), you must allow it here.
# Examples:
# CORS_ALLOW_ORIGINS=http://localhost:5173
# CORS_ALLOW_ORIGINS=https://your-frontend.vercel.app
# Or (public API) allow all origins:
# CORS_ALLOW_ORIGINS=*
CORS_ALLOW_ORIGINS=

# Supabase
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# OpenAI (required for chat + embeddings)
OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-4.1-mini
OPENAI_QUERY_PLANNER_MODEL=gpt-4.1-mini

# Embeddings
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Optional API auth for the backend
# API_KEY=
